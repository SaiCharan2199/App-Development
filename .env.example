# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your real values never reach GitHub.

# --- PostgreSQL (runs in Docker on your computer) ---
POSTGRES_USER=jobs_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Airflow (only needed for: docker compose --profile airflow up) ---
# Generate with:  python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (use os.urandom(64) for AIRFLOW_SECRET_KEY)
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_SECRET_KEY=change-me
